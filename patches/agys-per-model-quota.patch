+// retrieveUserQuota fetches the per-model quota buckets. The summary endpoint only
+// pools Claude/GPT models, so this is the only source for Gemini and other models.
+func retrieveUserQuota(ctx context.Context, accessToken, projectID string) ([]ModelQuotaBucket, error) {
+	url := "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuota"
+
+	reqBody := map[string]string{
+		"project": projectID,
+	}
+	bodyBytes, err := json.Marshal(reqBody)
+	if err != nil {
+		return nil, err
+	}
+
+	req, err := http.NewRequestWithContext(ctx, "POST", url, bytes.NewReader(bodyBytes))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+accessToken)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("User-Agent", "antigravity/1.11.9 darwin/arm64")
+
+	resp, err := httpClient.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		body, _ := io.ReadAll(resp.Body)
+		return nil, formatHTTPError(resp.StatusCode, body)
+	}
+
+	var list ModelQuotaList
+	if err := json.NewDecoder(resp.Body).Decode(&list); err != nil {
+		return nil, err
+	}
+
+	return list.Buckets, nil
+}
