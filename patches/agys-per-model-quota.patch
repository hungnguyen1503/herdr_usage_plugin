+// GroupDescriptionModels extracts the model names listed in a group description
+// ("Models within this group: A, B, C").
+func GroupDescriptionModels(description string) []string {
+	desc := description
+	if idx := strings.Index(strings.ToLower(desc), "models within this group:"); idx >= 0 {
+		desc = desc[idx+len("models within this group:"):]
+	}
+	var out []string
+	for _, name := range strings.Split(desc, ",") {
+		if name = strings.TrimSpace(name); name != "" && len(out) < 64 {
+			out = append(out, name)
+		}
+	}
+	return out
+}
+
+// normalizeModelName lowercases a model label and drops every non-alphanumeric
+// rune, so "Claude Opus 4.6" and "claude-opus-4-6-thinking" can be compared.
+func normalizeModelName(name string) string {
+	var b strings.Builder
+	for _, r := range strings.ToLower(name) {
+		if (r >= 'a' && r <= 'z') || (r >= '0' && r <= '9') {
+			b.WriteRune(r)
+		}
+	}
+	return b.String()
+}
+
+// CoveredModels returns the normalized model names already reported by the summary groups.
+func CoveredModels(summary *QuotaSummary) map[string]bool {
+	covered := make(map[string]bool)
+	if summary == nil {
+		return covered
+	}
+	for _, group := range summary.Groups {
+		for _, name := range GroupDescriptionModels(group.Description) {
+			if n := normalizeModelName(name); n != "" {
+				covered[n] = true
+			}
+		}
+	}
+	return covered
+}
+
+// modelCovered reports whether a per-model bucket is already described by a summary group.
+func modelCovered(modelID string, covered map[string]bool) bool {
+	id := normalizeModelName(modelID)
+	if id == "" {
+		return true
+	}
+	for name := range covered {
+		if strings.Contains(id, name) {
+			return true
+		}
+	}
+	return false
+}
+
+// uncoveredModelFamilies clusters per-model buckets that no summary group covers,
+// so the table and the herdr panel can show them as one row per shared limit.
+func uncoveredModelFamilies(summary *QuotaSummary) []ModelFamily {
+	if summary == nil || len(summary.Models) == 0 {
+		return nil
+	}
+	covered := CoveredModels(summary)
+
+	type clusterKey struct {
+		fraction int64
+		reset    int64
+	}
+	var order []clusterKey
+	families := make(map[clusterKey]*ModelFamily)
+
+	for _, bucket := range summary.Models {
+		id := strings.TrimSpace(bucket.ModelID)
+		if id == "" || modelCovered(id, covered) {
+			continue
+		}
+		key := clusterKey{fraction: int64(bucket.RemainingFraction * 1e6), reset: bucket.ResetTime.Unix()}
+		family, ok := families[key]
+		if !ok {
+			family = &ModelFamily{Name: ModelFamilyName(id), Bucket: bucket}
+			families[key] = family
+			order = append(order, key)
+		}
+		family.Models = append(family.Models, id)
+	}
+
+	out := make([]ModelFamily, 0, len(order))
+	for _, key := range order {
+		out = append(out, *families[key])
+	}
+	return out
+}
+
+// ModelFamilyName maps a model ID to the family label shown in quota output.
+func ModelFamilyName(modelID string) string {
+	id := strings.ToLower(strings.TrimSpace(modelID))
+	switch {
+	case strings.HasPrefix(id, "gemini"):
+		return "Gemini models"
+	case strings.Contains(id, "claude"):
+		return "Claude models"
+	case strings.Contains(id, "gpt"):
+		return "GPT models"
+	case strings.HasPrefix(id, "tab_"):
+		return "Tab models"
+	}
+	return "Other models"
+}
