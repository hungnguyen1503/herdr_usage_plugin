+func TestUncoveredModelFamilies(t *testing.T) {
+	reset := time.Date(2026, 11, 25, 4, 35, 0, 0, time.UTC)
+	summary := &QuotaSummary{
+		Groups: []QuotaGroup{{
+			DisplayName: "Claude and GPT models",
+			Description: "Models within this group: Claude Sonnet 4.6, Claude Opus 4.6, GPT-OSS 120B",
+		}},
+		Models: []ModelQuotaBucket{
+			{ModelID: "claude-sonnet-4-6", RemainingFraction: 1},
+			{ModelID: "claude-opus-4-6-thinking", RemainingFraction: 1},
+			{ModelID: "gpt-oss-120b-medium", RemainingFraction: 1},
+			{ModelID: "gemini-3-flash", RemainingFraction: 0.875, ResetTime: reset},
+			{ModelID: "gemini-3.8-flash-tiered", RemainingFraction: 0.875, ResetTime: reset},
+			{ModelID: "tab_flash_lite_preview", RemainingFraction: 1},
+		},
+	}
+
+	families := uncoveredModelFamilies(summary)
+	if len(families) != 2 {
+		t.Fatalf("expected 2 families (gemini + tab), got %d: %+v", len(families), families)
+	}
+	if families[0].Name != "Gemini models" || len(families[0].Models) != 2 {
+		t.Errorf("unexpected first family: %+v", families[0])
+	}
+	if families[0].Bucket.RemainingFraction != 0.875 || !families[0].Bucket.ResetTime.Equal(reset) {
+		t.Errorf("unexpected gemini bucket: %+v", families[0].Bucket)
+	}
+	if families[1].Name != "Tab models" || len(families[1].Models) != 1 {
+		t.Errorf("unexpected second family: %+v", families[1])
+	}
+
+	cached := &QuotaSummary{Groups: summary.Groups}
+	if got := uncoveredModelFamilies(cached); got != nil {
+		t.Errorf("expected no families without models, got %+v", got)
+	}
+}
+
+func TestModelFamilyName(t *testing.T) {
+	cases := map[string]string{
+		"gemini-2.5-pro":              "Gemini models",
+		"claude-opus-5-5-medium":      "Claude models",
+		"gpt-oss-120b-medium":         "GPT models",
+		"tab_jump_flash_lite_preview": "Tab models",
+		"mystery-model":               "Other models",
+	}
+	for id, want := range cases {
+		if got := ModelFamilyName(id); got != want {
+			t.Errorf("ModelFamilyName(%q) = %q, want %q", id, got, want)
+		}
+	}
+}
